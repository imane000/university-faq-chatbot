# Copy to backend/.env. Keep the actual key on the backend only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_TOKENS=1024
# Relative paths resolve from backend/, independent of the working directory.
CHROMA_PATH=chroma_db
CHROMA_COLLECTION=university_knowledge
DATA_PATH=data
RAG_TOP_K=4
# Cosine distance: lower is closer. Tune against a labelled evaluation set.
RAG_MAX_DISTANCE=0.5
RAG_CONTEXT_CHARS=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
